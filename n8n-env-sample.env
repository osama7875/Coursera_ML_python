# n8n Environment Configuration Sample
# Copy this file to .env and update with your actual values

# =============================================================================
# BASIC N8N CONFIGURATION
# =============================================================================

# n8n basic settings
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# n8n host and port
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# For production, use HTTPS
# N8N_PROTOCOL=https
# N8N_HOST=your-domain.com

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook URL base (automatically constructed)
# For local development: http://localhost:5678
# For production: https://your-domain.com
WEBHOOK_URL=http://localhost:5678

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================

# Google OAuth2 credentials for Google Sheets and Gmail
# Get these from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Google Sheet Configuration
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_SHEET_RANGE=A:Z

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Gmail settings
GMAIL_SENDER_EMAIL=your-sender@gmail.com
GMAIL_RECIPIENT_EMAIL=recipient@gmail.com

# Additional email recipients (comma-separated)
GMAIL_CC_EMAILS=cc1@gmail.com,cc2@gmail.com
GMAIL_BCC_EMAILS=bcc1@gmail.com,bcc2@gmail.com

# =============================================================================
# SCHEDULING CONFIGURATION
# =============================================================================

# Cron expression for daily email (default: 9 AM daily)
SCHEDULE_CRON=0 9 * * *

# Timezone for scheduling
SCHEDULE_TIMEZONE=America/New_York

# =============================================================================
# WORKFLOW CONFIGURATION
# =============================================================================

# Maximum number of sample rows to include in email
MAX_SAMPLE_ROWS=5

# Email subject prefix
EMAIL_SUBJECT_PREFIX=Daily Sheet Summary

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# n8n security settings
N8N_SECURE_COOKIE=false
N8N_COOKIE_SAME_SITE_POLICY=lax

# For production, enable security
# N8N_SECURE_COOKIE=true
# N8N_COOKIE_SAME_SITE_POLICY=strict

# JWT settings for n8n
N8N_JWT_AUTH_ACTIVE=false
# N8N_JWT_AUTH_HEADER=authorization
# N8N_JWT_AUTH_HEADER_VALUE_PREFIX=Bearer

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================

# Default: SQLite (file-based)
# For production, consider PostgreSQL or MySQL

# SQLite (default)
DB_TYPE=sqlite
DB_SQLITE_DATABASE=n8n.db

# PostgreSQL example
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n_user
# DB_POSTGRESDB_PASSWORD=n8n_password

# MySQL example
# DB_TYPE=mysqldb
# DB_MYSQLDB_HOST=localhost
# DB_MYSQLDB_PORT=3306
# DB_MYSQLDB_DATABASE=n8n
# DB_MYSQLDB_USER=n8n_user
# DB_MYSQLDB_PASSWORD=n8n_password

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: error, warn, info, verbose, debug, silly
N8N_LOG_LEVEL=info

# Log output format
N8N_LOG_OUTPUT=console

# For production, log to file
# N8N_LOG_OUTPUT=file
# N8N_LOG_FILE_LOCATION=/var/log/n8n/n8n.log

# =============================================================================
# ADDITIONAL SETTINGS
# =============================================================================

# Execution timeout (in seconds)
EXECUTIONS_TIMEOUT=3600

# Maximum execution history to keep
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Maximum file size for uploads (in MB)
N8N_MAX_FILE_SIZE=16

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Skip SSL verification (only for development)
NODE_TLS_REJECT_UNAUTHORIZED=1

# For development with self-signed certificates
# NODE_TLS_REJECT_UNAUTHORIZED=0

# =============================================================================
# WEBHOOK SECURITY (Optional)
# =============================================================================

# Enable webhook authentication
WEBHOOK_AUTH_ACTIVE=false
# WEBHOOK_AUTH_HEADER=x-api-key
# WEBHOOK_AUTH_VALUE=your-webhook-secret-key

# =============================================================================
# MONITORING & HEALTH CHECK
# =============================================================================

# Health check endpoint
N8N_DIAGNOSTICS_ENABLED=true
N8N_VERSION_NOTIFICATIONS_ENABLED=true

# Metrics endpoint (for monitoring)
N8N_METRICS=false
# N8N_METRICS_PREFIX=n8n_

# =============================================================================
# NOTES & INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env in your n8n installation directory
# 2. Update all placeholder values with your actual configuration
# 3. For Google OAuth setup:
#    - Go to Google Cloud Console
#    - Create a new project or select existing
#    - Enable Google Sheets API and Gmail API
#    - Create OAuth2 credentials
#    - Add redirect URI: http://localhost:5678/rest/oauth2-credential/callback
# 4. For production deployment:
#    - Use HTTPS (N8N_PROTOCOL=https)
#    - Enable security features
#    - Use a proper database (PostgreSQL/MySQL)
#    - Set up proper logging
#    - Use environment-specific values
# 5. Test the configuration:
#    - Start n8n with: n8n start
#    - Access: http://localhost:5678
#    - Import the workflow
#    - Configure credentials
#    - Test manually before enabling schedule